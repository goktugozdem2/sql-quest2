{
  "buildCommand": "npm run build",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "docs/**": false,
      "feat/**": false,
      "fix/**": false,
      "qa/**": false,
      "claude/**": false,
      "content/**": false,
      "chore/**": false,
      "flags/**": false,
      "goal/**": false,
      "funnel/**": false,
      "ci/**": false,
      "seo/**": false,
      "review/**": false,
      "agent/**": false,
      "mon/**": false,
      "test/**": false,
      "c1/**": false,
      "c2/**": false,
      "c3/**": false,
      "c4/**": false,
      "c5/**": false,
      "c6/**": false,
      "c7/**": false,
      "b1/**": false,
      "b2/**": false,
      "b3/**": false,
      "b4/**": false,
      "b5/**": false,
      "b6/**": false,
      "a1/**": false,
      "a2/**": false,
      "a3/**": false,
      "a4/**": false,
      "e1/**": false,
      "d2/**": false,
      "q1/**": false,
      "s1/**": false,
      "r1/**": false,
      "*/**": false
    }
  },
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sqlquest.app"
        }
      ],
      "destination": "https://sqlquest.app/:path*",
      "permanent": true
    },
    {
      "source": "/coach/",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:slug/privacy/",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/:slug/terms/",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/:slug/refund/",
      "destination": "/refund/",
      "permanent": true
    },
    {
      "source": "/:slug/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/:slug/terms.html",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/:slug/refund.html",
      "destination": "/refund/",
      "permanent": true
    },
    {
      "source": "/:slug/app/",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/app/",
      "has": [
        {
          "type": "query",
          "key": "sector",
          "value": "finans"
        }
      ],
      "destination": "/app/?sector=finance",
      "permanent": true
    },
    {
      "source": "/app/",
      "has": [
        {
          "type": "query",
          "key": "sector",
          "value": "gayrimenkul"
        }
      ],
      "destination": "/app/?sector=real-estate",
      "permanent": true
    },
    {
      "source": "/app/",
      "has": [
        {
          "type": "query",
          "key": "sector",
          "value": "uretim"
        }
      ],
      "destination": "/app/?sector=manufacturing",
      "permanent": true
    },
    {
      "source": "/app.html",
      "has": [
        {
          "type": "query",
          "key": "sector",
          "value": "finans"
        }
      ],
      "destination": "/app/?sector=finance",
      "permanent": true
    },
    {
      "source": "/app.html",
      "has": [
        {
          "type": "query",
          "key": "sector",
          "value": "gayrimenkul"
        }
      ],
      "destination": "/app/?sector=real-estate",
      "permanent": true
    },
    {
      "source": "/app.html",
      "has": [
        {
          "type": "query",
          "key": "sector",
          "value": "uretim"
        }
      ],
      "destination": "/app/?sector=manufacturing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/u/(.*)",
      "destination": "/api/u?handle=$1"
    }
  ],
  "functions": {
    "api/u.js": {
      "includeFiles": "public/app.html"
    },
    "api/og-card.js": {
      "includeFiles": "assets/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
