{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sqlquest.app" }],
      "destination": "https://sqlquest.app/:path*",
      "permanent": true
    },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/fr/", "destination": "/", "permanent": true },
    { "source": "/:slug/privacy/", "destination": "/privacy/", "permanent": true },
    { "source": "/:slug/terms/", "destination": "/terms/", "permanent": true },
    { "source": "/:slug/refund/", "destination": "/refund/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/u/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
